# ---- Postgres ----
# When deploying to Render or external Postgres, set DATABASE_URL (Render automatically sets this):
# DATABASE_URL=postgresql://user:password@hostname:5432/dbname
POSTGRES_USER=voice_app
POSTGRES_PASSWORD=change_me
POSTGRES_DB=voice_app
POSTGRES_HOST=db
POSTGRES_PORT=5432

# ---- Backend ----
# CORS origin for the frontend dev server
BACKEND_CORS_ORIGINS=http://localhost:5173

# Public base URL of THIS backend, used to build webhook callback URLs
# that Hunar will call back into (must be a public HTTPS URL in production,
# e.g. an ngrok tunnel in local dev).
PUBLIC_BASE_URL=http://localhost:8000

# ---- Hunar Voice Agents ----
# NEVER commit a real key. Rotate the key that was shared in chat before using it.
HUNAR_API_KEY=replace_me
HUNAR_API_BASE_URL=https://api.voice.hunar.ai/external/v1
# Default agent used for hiring-assistant calls (create one in Hunar dashboard/API first)
HUNAR_HIRING_AGENT_ID=
# Default agent used for people-search reachout calls
HUNAR_REACHOUT_AGENT_ID=
# Shared secret Hunar signs webhooks with (see org settings) - used to verify X-Hunar-Signature
HUNAR_WEBHOOK_SECRET=

# ---- People Search Provider ----
# One of: sandbox (free mock dataset for testing), apollo, pdl
PEOPLE_SEARCH_PROVIDER=sandbox
APOLLO_API_KEY=
PDL_API_KEY=

# ---- LLM (JD criteria extraction + candidate ranking) ----
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
